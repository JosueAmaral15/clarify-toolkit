import React from 'react';

function HomePage() {
  return (
    <div>
      <h1>{t.pages.home.title}</h1>
      <p>{t.pages.home.subtitle}</p>
      <button>{t.common.button.submit}</button>
    </div>
  );
}

function AboutPage() {
  return (
    <div>
      <h1>{t.pages.about.title}</h1>
      <p>{t.pages.about.description}</p>
      <button>{t.common.button.save}</button>
    </div>
  );
}

function ContactPage() {
  return (
    <div>
      <h1>{t.pages.contact.title}</h1>
      <label>{t.pages.contact.email}</label>
      <label>{t.pages.contact.phone}</label>
      <button>{t.common.button.cancel}</button>
    </div>
  );
}

export { HomePage, AboutPage, ContactPage };
